# Copy to .env.local and fill in. Never commit .env.local.

# Admin dashboard password.
# If unset, the password is "admin" (in every environment).
ADMIN_PASSWORD=

# Secret used to sign the admin session cookie. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Public URL of the site (used for canonical links, sitemap and social previews).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
